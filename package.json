{
  "name": "void-monster-module-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "astro dev --host 127.0.0.1",
    "prepare:docs": "node tools/prepare-docs.mjs",
    "build": "yarn prepare:docs && astro build && node tools/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "release:import": "node tools/import-release.mjs",
    "docs:prepare": "yarn build",
    "docs:check": "yarn security:check && yarn lint && yarn typecheck && yarn test && yarn build",
    "deploy": "yarn docs:check && wrangler deploy",
    "security:check": "yarn npm audit --all --recursive"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.92.0"
  }
}
