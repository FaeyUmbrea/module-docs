---
import { modules, preferredRelease, releaseUrl } from '../lib/docs';
---
<div class="module-catalogue">
  {modules.map((module) => {
    const release = preferredRelease(module);
    return <article class="module-card">
      <h2><a href={releaseUrl(module.id, release)}>{module.title}</a></h2>
      <p>{module.summary}</p>
      <div class="module-status">{release.legacy ? 'In development' : `${release.channel === 'premium' ? 'Premium' : 'Public'} · ${release.version}`}</div>
      <nav aria-label={`${module.title} documentation`}><a href={releaseUrl(module.id, release)}>User guide <span aria-hidden="true">↗</span></a><a href={releaseUrl(module.id, release, 'dev')}>Developer docs</a></nav>
    </article>;
  })}
</div>
<style>
  .module-catalogue { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .module-card { display: flex; flex-direction: column; padding: 1.6rem; border: 1px solid var(--vm-card-border); background: var(--vm-card-bg); border-radius: 12px; box-shadow: inset 0 0 45px #7c23300a; transition: border-color .2s, box-shadow .2s; }
  .module-card:hover, .module-card:focus-within { border-color: var(--vm-red); box-shadow: 0 8px 35px #a8232e20, inset 0 0 35px #7c233014; }
  .module-card h2 { font-size: 1.2rem; line-height: 1.4; margin: 0; letter-spacing: -.02em; }
  .module-card h2 a { color: var(--sl-color-white); text-decoration: none; }
  .module-card p { margin: .7rem 0 1rem; font-size: .9rem; color: var(--sl-color-gray-2); line-height: 1.6; }
  .module-status { font-size: .75rem; border-left: 2px solid var(--vm-gold); padding-left: .6rem; color: var(--sl-color-gray-2); margin-top: auto; }
  .module-card nav { display: flex; flex-wrap: wrap; gap: 1.3rem; border-top: 1px solid var(--sl-color-hairline); padding-top: 1rem; margin-top: 1rem; }
  .module-card nav a { font-size: .8rem; text-decoration: none; color: var(--sl-color-text-accent); }
  .module-card nav a:first-child { color: var(--sl-color-white); font-weight: 600; }
  @media (max-width: 40rem) { .module-catalogue { grid-template-columns: 1fr; } }
</style>
