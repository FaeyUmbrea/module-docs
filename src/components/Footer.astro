---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { Icon } from '@astrojs/starlight/components';
---
<footer data-pagefind-ignore>
  <Pagination />
  <div class="docs-footer"><a class="main-site-link" href="https://void.monster"><span>Visit void.monster</span><Icon name="external" /></a><nav aria-label="Community links"><a href="https://discord.com/invite/WfMaKPPdeM"><Icon name="discord" />Discord</a><a href="https://www.patreon.com/bePatron?u=28777355"><Icon name="patreon" />Patreon</a><a href="https://github.com/FaeyUmbrea"><Icon name="github" />GitHub</a></nav></div>
</footer>
<style>
  footer { margin-top: 3rem; }
  .docs-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 1px solid var(--sl-color-hairline); padding-top: 1.5rem; margin-top: 2rem; font-size: .75rem; color: var(--sl-color-gray-2); }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  a { display: inline-flex; align-items: center; gap: .4rem; color: inherit; text-decoration: none; }
  .main-site-link { color: var(--sl-color-text-accent); }
  .main-site-link > span:first-child { text-decoration: underline; text-underline-offset: .2em; }
  a:hover, a:focus-visible { color: var(--sl-color-white); text-decoration: underline; }
</style>
